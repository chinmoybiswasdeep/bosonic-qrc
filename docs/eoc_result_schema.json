{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corrected bosonic QRC EOC result",
  "type": "object",
  "required": [
    "schema_version", "branch", "base_commit", "git_commit", "configuration",
    "config_hash", "chunk", "closed_calibration", "cutoff_convergence",
    "open_system", "performance_vs_d_eoc", "runtime", "environment", "gate",
    "warnings", "artifact_checksums"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0-eoc"},
    "branch": {"const": "EOC-CVMB"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration": {"type": "object"},
    "chunk": {"type": "object", "required": ["index", "count", "interactions"]},
    "closed_calibration": {"type": "object", "required": ["sizes", "edge_estimate", "validation", "d_eoc_definition"]},
    "cutoff_convergence": {"type": "object", "required": ["comparisons", "thresholds", "passed"]},
    "open_system": {"type": "array"},
    "performance_vs_d_eoc": {"type": "object"},
    "runtime": {"type": "object", "required": ["seconds", "python_tracemalloc_peak_bytes"]},
    "environment": {"type": "object", "required": ["python", "platform", "dependencies"]},
    "gate": {"type": "object", "required": ["status", "edge_of_many_body_quantum_chaos_claim", "checks"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "artifact_checksums": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
